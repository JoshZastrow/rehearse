# Voice session
HUME_API_KEY=
HUME_CONFIG_ID=
HUME_CLM_SECRET=

# Memory (caller consent history across calls)
# Option A: Honcho cloud API (recommended for production)
HONCHO_API_KEY=
HONCHO_WORKSPACE_ID=rehearse
# Option B: Self-hosted Honcho (run 'make setup-honcho' once, then 'make serve')
# HONCHO_BASE_URL=http://localhost:8001
# (leave HONCHO_API_KEY empty when using HONCHO_BASE_URL)

# Coach brain
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server
BASE_URL=https://your-ngrok-or-fly-host.example
PORT=8000

# Storage
SESSIONS_DIR=./sessions
LOG_LEVEL=info
VALIDATE_TWILIO_SIGNATURE=1
