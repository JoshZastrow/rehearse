# Voice session
HUME_API_KEY=
HUME_CONFIG_ID=
HUME_CLM_SECRET=

# Memory (caller consent history across calls)
#
# Priority: MEMORY_MCP_URL > HONCHO_BASE_URL (self-hosted) > HONCHO_API_KEY (cloud)
#
# Local development (recommended) — no cloud account needed:
#   1. Run: make setup-honcho
#   2. Uncomment the line below:
# HONCHO_BASE_URL=http://localhost:8001
#
# Cloud (production / when you don't want to run a local server):
# HONCHO_API_KEY=
#
# MCP server (any MCP-compatible memory backend):
# MEMORY_MCP_URL=http://localhost:3333
#
HONCHO_WORKSPACE_ID=rehearse

# Coach brain
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server
BASE_URL=https://your-ngrok-or-fly-host.example
PORT=8000

# Storage
SESSIONS_DIR=./sessions
LOG_LEVEL=info
VALIDATE_TWILIO_SIGNATURE=1
