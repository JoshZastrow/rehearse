# Voice session
HUME_API_KEY=
HUME_CONFIG_ID=
HUME_CLM_SECRET=

# Memory (caller consent history across calls)
#
# Priority: MEMORY_MCP_URL > HONCHO_BASE_URL (self-hosted) > HONCHO_API_KEY (cloud)
#
# Local development (recommended) — no cloud account needed:
#   1. Run: make setup-honcho
#   2. Uncomment the line below:
# HONCHO_BASE_URL=http://localhost:8001
#
# Cloud (production / when you don't want to run a local server):
# HONCHO_API_KEY=
#
# MCP server (any MCP-compatible memory backend):
# MEMORY_MCP_URL=http://localhost:3333
#
HONCHO_WORKSPACE_ID=rehearse

# ── Inference ────────────────────────────────────────────────────────────────
#
# Two paths — pick one:
#
# A) Direct Anthropic (simplest, no proxy needed):
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
#
# B) LiteLLM proxy — routes all model calls through localhost:4000.
#    Enables self-hosted models (Gemma 4 on Modal) and easy backend swaps.
#    Run 'make serve' to start the proxy automatically, or manually:
#      litellm --config infra/litellm_config.yaml
#
#    LITELLM_MASTER_KEY and LITELLM_API_KEY must be the same value.
#    LITELLM_BASE_URL and LITELLM_MODEL are the only vars your app needs.
#    PIPELINE_CLM_URL and PIPELINE_CLM_MODEL are derived automatically.
#
# LITELLM_MASTER_KEY=sk-rehearse-local   # proxy auth key (set on the proxy process)
# LITELLM_BASE_URL=http://localhost:4000  # proxy base URL
# LITELLM_API_KEY=sk-rehearse-local      # must match LITELLM_MASTER_KEY
# LITELLM_MODEL=coach                     # model alias (default: coach)
# MODAL_GEMMA_API_KEY=                    # modal token new  (for Gemma 4 on Modal)
#
# ── Backend type ──────────────────────────────────────────────────────────────
# managed     = Hume EVI handles voice + STT + TTS (default)
# pipeline    = open-source STT (Whisper) + TTS (Kokoro) + LiteLLM for LLM calls
# interactive = full-duplex speech model on Modal GPU (see infra/interactive.py)
# BACKEND_TYPE=managed

# ── Interactive backend (BACKEND_TYPE=interactive) ───────────────────────────
#
# Deploy the servers first: make deploy-interactive
# INTERACTIVE_MODEL_TYPE selects the model family ("moshi" or "personaplex");
# point the endpoint at the matching deployed server class.
# PersonaPlex (nvidia/personaplex-7b-v1) adds voice + role conditioning —
# defaults live in infra/interactive.py and can be overridden per session via
# the start handshake (text_prompt / voice_prompt) or via PERSONAPLEX_* below.
#
# INTERACTIVE_MODEL_TYPE=moshi
# INTERACTIVE_PROVIDER_ENDPOINT=wss://<workspace>--rehearse-interactive-providerserver-serve.modal.run/ws
# INTERACTIVE_CALLER_ENDPOINT=wss://<workspace>--rehearse-interactive-callerserver-serve.modal.run/ws
#
# INTERACTIVE_MODEL_TYPE=personaplex
# INTERACTIVE_PROVIDER_ENDPOINT=wss://<workspace>--rehearse-interactive-personaplexprovider-serve.modal.run/ws
# INTERACTIVE_CALLER_ENDPOINT=wss://<workspace>--rehearse-interactive-personaplexcaller-serve.modal.run/ws
# PERSONAPLEX_TEXT_PROMPT=            # server-side default role prompt override
# PERSONAPLEX_VOICE_PROMPT=           # e.g. NATF0.pt / NATM2.pt / VARF3.pt

# ── Eval caller LLM ──────────────────────────────────────────────────────────
#
# Used when running evals with --caller <model> for non-Anthropic models.
# CALLER_VLLM_BASE_URL is the OpenAI-compatible endpoint for vLLM-served models
# (e.g. gemma-4-26b). Kept separate from VLLM_BASE_URL used by the audio judge.
#
# CALLER_VLLM_BASE_URL=https://your-vllm-host.example/v1
# CALLER_VLLM_API_KEY=

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Server
BASE_URL=https://your-ngrok-or-fly-host.example
PORT=8000

# Storage
SESSIONS_DIR=./sessions
LOG_LEVEL=info
VALIDATE_TWILIO_SIGNATURE=1

WANDB_API_KEY=
HF_TOKEN=
