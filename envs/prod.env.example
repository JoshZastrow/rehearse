# Production config for the consumer web backend (token server + agent).
#
# Copy to envs/prod.env (gitignored), fill in real values, then push to Modal:
#   make sync-secrets            # writes these into the `rehearse-web` Modal secret
#   make deploy-web              # deploys infra/web.py using that secret
#
# Both the token server (asgi) and the per-call agent (spawned) read these as
# environment variables inside their Modal containers.

# ── Auth (Clerk) ──────────────────────────────────────────────────────────────
CLERK_JWKS_URL=https://clerk.rehearse.conle.ai/.well-known/jwks.json
CLERK_ISSUER=https://clerk.rehearse.conle.ai

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Billing (Stripe + Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgres://...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Interactive model (Modal, scale-to-zero) ──────────────────────────────────
# The agent opens this socket; the token server derives its /health for /warm.
INTERACTIVE_PROVIDER_ENDPOINT=wss://<workspace>--rehearse-interactive-personaplexprovider-serve.modal.run/ws

# ── Token server policy ───────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://rehearse.conle.ai
# Dispatch marker: on Modal the token server spawns the agent function (not HTTP),
# so this only needs to be non-empty to enable dispatch. Leave as "spawn".
AGENT_DISPATCH_URL=spawn
# MONTHLY_CREDIT_CEILING=5000
# TOKEN_TTL_SECONDS=900
# RATE_LIMIT_PER_MINUTE=6
# WARM_TIMEOUT_SECONDS=90
